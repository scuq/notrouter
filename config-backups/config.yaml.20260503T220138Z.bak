listen:
  webhook: ":8080"
  syslog_udp: ":5514"
  syslog_tcp: ":5514"
  admin: ":9090"

links:
  grafana: "https://grafana.example.com/d/abc/notrouter"
  runbook: "https://wiki.example.com/notrouter2"
  github: "https://gitlab.example.com/scuq/notrouter"

auth:
  admin:
    # Username for legacy basic auth on /admin/state, /admin/deliveries,
    # /admin/dedup/clear. The web UI password is managed in creds_path.
    username: admin
    password: "CHANGE_ME_to_something_strong"

    # Persisted credentials file. First run seeds it with admin/admin and
    # MustChange=true; the UI forces a password rotation on first login.
    # OIDC client config will land here in a future iteration.
    creds_path: /var/lib/notrouter/creds.json

    # Web UI session length. After this, users must log in again.
    session_ttl: 2h

receivers:
  webhook:
    endpoints:
      - path: /webhook/nagios
        profile: nagios
      - path: /webhook/generic
        profile: generic

profiles:
  nagios:
    entity:
      from_json: "$.host"
    normalize:
      topic: "nagios-{{.json.type}}-{{.json.state | lower}}"
      urgency:
        from_json: "$.state"
        map:
          OK: info
          UP: info
          WARNING: medium
          CRITICAL: critical
          DOWN: high
          UNREACHABLE: high
    attributes:
      msg:
        from_json: "$.output"
      service:
        from_json: "$.service"
      source_kind:
        static: "nagios"

  generic:
    entity:
      from_json: "$.entity"

dedup:
  ttl: 5m
  key_fields: [entity, topic]

suppressors:
  - name: ignore-test-hosts
    match:
      entity_regex: "^test-.*"

logging:
  level: info
  suppressor_log_throttle: 60s

plugin_instances:
  webex_noc:
    type: webex
    config:
      webhook_url: "https://webexapis.com/v1/webhooks/incoming/REPLACE_ME"
      timeout: "15s"
      rate_limit_grace: "2s"
    retry:
      attempts: 5
      backoff: [2s, 5s, 10s, 30s, 60s]

  file_audit:
    type: file
    config:
      path: /var/log/notrouter/audit.jsonl

groups:
  noc-team:
    subscribers: [webex_noc, file_audit]

routing:
  - match: {}
    groups: [noc-team]

dispatch:
  global_delivery_ttl: 30m
  default_retry:
    attempts: 3
    backoff: [1s, 5s, 30s]

pipeline:
  raw_buffer_size: 4096
  normal_buffer_size: 2048
  instance_buffer_size: 1024
  resolver_workers: 4
  normalizer_workers: 4
